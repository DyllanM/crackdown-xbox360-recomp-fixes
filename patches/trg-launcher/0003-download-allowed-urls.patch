+  const std::wstring user_agent = Widen(options.user_agent);
+  if (wurl.empty() || user_agent.empty()) {
+    return "Not a valid web address.";
+  }
+
+  URL_COMPONENTSW parts{};
+  parts.dwStructSize = sizeof(parts);
+  std::vector<wchar_t> host(wurl.size() + 1);
+  std::vector<wchar_t> path(wurl.size() + 1);
+  parts.lpszHostName = host.data();
+  parts.dwHostNameLength = DWORD(host.size());
+  parts.lpszUrlPath = path.data();
+  parts.dwUrlPathLength = DWORD(path.size());
+  if (!WinHttpCrackUrl(wurl.c_str(), DWORD(wurl.size()), 0, &parts)) {
+    return "Not a valid web address.";
+  }
+  if (parts.nScheme != INTERNET_SCHEME_HTTPS && parts.nScheme != INTERNET_SCHEME_HTTP) {
+    return "Only web addresses can be downloaded.";
+  }
+
+  std::wstring headers;
+  for (const HttpHeader& header : options.headers) {
+    headers += Widen(header.name + ": " + header.value + "\r\n");
+  }
+
+  HINTERNET session =
+      WinHttpOpen(user_agent.c_str(), WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY, WINHTTP_NO_PROXY_NAME,
+                  WINHTTP_NO_PROXY_BYPASS, 0);
+  if (!session) {
+    return "Could not start the download.";
+  }
+  WinHttpSetTimeouts(session, options.connect_timeout_ms, options.connect_timeout_ms, options.receive_timeout_ms,
+                     options.receive_timeout_ms);
+  std::string error = "Could not reach the server. Check your internet connection and try again.";
+  if (HINTERNET conn = WinHttpConnect(session, host.data(), parts.nPort, 0)) {
+    const DWORD flags = parts.nScheme == INTERNET_SCHEME_HTTPS ? WINHTTP_FLAG_SECURE : 0;
+    if (HINTERNET req = WinHttpOpenRequest(conn, L"GET", path.data(), nullptr, WINHTTP_NO_REFERER,
+                                           WINHTTP_DEFAULT_ACCEPT_TYPES, flags)) {
+      DWORD redirects =
+          follow ? WINHTTP_OPTION_REDIRECT_POLICY_DISALLOW_HTTPS_TO_HTTP : WINHTTP_OPTION_REDIRECT_POLICY_NEVER;
+      WinHttpSetOption(req, WINHTTP_OPTION_REDIRECT_POLICY, &redirects, sizeof(redirects));
+      DWORD code = 0;
+      DWORD length = sizeof(code);
+      if (WinHttpSendRequest(req, headers.empty() ? WINHTTP_NO_ADDITIONAL_HEADERS : headers.c_str(),
+                             DWORD(headers.size()), WINHTTP_NO_REQUEST_DATA, 0, 0, 0) &&
+          WinHttpReceiveResponse(req, nullptr) &&
+          WinHttpQueryHeaders(req, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, nullptr, &code, &length,
+                              nullptr)) {
+        if (!follow && IsRedirect(long(code))) {
+          redirect = Location(req);
+          error = redirect.empty() ? "The server sent an invalid redirect." : "";
+        } else if (code != 200) {
+          error = "The server answered " + std::to_string(code) + ".";
+        } else {
+          DWORD content = 0;
+          length = sizeof(content);
+          const bool sized = WinHttpQueryHeaders(req, WINHTTP_QUERY_CONTENT_LENGTH | WINHTTP_QUERY_FLAG_NUMBER,
+                                                 nullptr, &content, &length, nullptr) != FALSE;
+          error.clear();
+          const auto started = std::chrono::steady_clock::now();
+          for (DWORD available = 0; WinHttpQueryDataAvailable(req, &available) && available;) {
+            if (task && task->cancelled()) {
+              error = "Cancelled.";
+              break;
+            }
+            if (options.total_timeout_ms > 0) {
+              const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                       std::chrono::steady_clock::now() - started)
+                                       .count();
+              if (elapsed > options.total_timeout_ms) {
+                error = "The server took too long to answer.";
+                break;
+              }
+            }
+            const size_t at = out.size();
+            if (options.max_bytes > 0 && at + size_t(available) > size_t(options.max_bytes)) {
+              error = "The server sent more data than expected.";
+              break;
+            }
+            out.resize(at + available);
+            DWORD read = 0;
+            if (!WinHttpReadData(req, out.data() + at, available, &read)) {
+              error = "The download was interrupted.";
+              out.resize(at);
+              break;
+            }
+            out.resize(at + read);
+            if (task) {
+              const long long total =
+                  options.progress_total > 0 ? options.progress_total
+                                             : (sized ? static_cast<long long>(content) : -1);
+              task->Progress(static_cast<long long>(out.size()), total);
+            }
+          }
+        }
+      }
+      WinHttpCloseHandle(req);
+    }
+    WinHttpCloseHandle(conn);
+  }
+  WinHttpCloseHandle(session);
+  return error;
+}
