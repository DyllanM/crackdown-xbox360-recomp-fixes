-    nav_suspended_ = false;
-  }
-
-  if (want_quit_) {
-    want_quit_ = want_play_ = false;
-    return Result::kQuit;
-  }
-  if (autoplay_frames_ > 0 && --autoplay_frames_ == 0) {
-    prompt_confirmed_ = true;
