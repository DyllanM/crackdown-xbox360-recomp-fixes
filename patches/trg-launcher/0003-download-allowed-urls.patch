+                                           ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoTitleBar |
+                                               ImGuiWindowFlags_NoSavedSettings);
+  ImGui::PopStyleVar();
+  if (open) {
+    ImGui::PushFont(fonts().semibold, 0.0f);
