+// Draws `text` at `pos` and returns its advance. A non-empty url makes it a
+// hyperlink: always underlined except while hovered, then the hand cursor, a
+// tooltip with the url and a click that opens it.
+float LinkText(ImDrawList* dl, const char* id, ImVec2 pos, ImFont* font, float size, ImU32 color,
+               const char* text, const std::string& url) {
+  const char* end = text + std::strlen(text);
+  const ImVec2 extent = font->CalcTextSizeA(size, FLT_MAX, 0.0f, text, end);
+  bool hovered = false;
+  if (!url.empty()) {
+    ImGui::PushID(id);
+    ImGui::SetCursorScreenPos(pos);
+    if (ImGui::InvisibleButton("##link", extent)) OpenUrl(url);
+    hovered = ImGui::IsItemHovered();
+    if (hovered) {
+      ImGui::SetMouseCursor(ImGuiMouseCursor_Hand);
+      ImGui::SetTooltip("%s", url.c_str());
+    }
+    ImGui::PopID();
+  }
+  dl->AddText(font, size, pos, color, text, end);
+  if (!url.empty() && !hovered) {
+    const float thickness = std::max(extent.y * 0.06f, 1.0f);
+    const float y = pos.y + extent.y - thickness;
+    dl->AddLine(ImVec2(pos.x, y), ImVec2(pos.x + extent.x, y), color, thickness);
+  }
+  return extent.x;
+}
