+    ImGui::SameLine();
+    if (ImGui::Button(cancel, ImVec2(150 * scale_, 0)) || ImGui::IsKeyPressed(ImGuiKey_Escape, false))
+      ImGui::CloseCurrentPopup();
+    ImGui::EndPopup();
+  }
+  ImGui::PopID();
+  return confirmed;
