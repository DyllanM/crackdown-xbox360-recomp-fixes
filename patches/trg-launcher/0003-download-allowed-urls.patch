+
+#else
+
+namespace {
+
+std::string ShellQuote(std::string_view text) {
+  std::string quoted = "'";
+  for (const char c : text) {
+    if (c == '\'') {
+      quoted += "'\\''";
+    } else {
+      quoted += c;
+    }
+  }
+  quoted += '\'';
+  return quoted;
+}
+
+long long Seconds(int milliseconds) {
+  if (milliseconds <= 0) {
+    return 0;
+  }
+  return std::max<long long>(1, (static_cast<long long>(milliseconds) + 999) / 1000);
+}
+
+constexpr std::string_view kStatusMarker = "\ntrg-http-status:";
+
+std::string GetOnce(const std::string& url, std::string& out, Task* task, const HttpOptions& options, bool follow,
+                    std::string& redirect) {
+  out.clear();
+  redirect.clear();
+  for (const char c : url) {
+    if (c == '\'' || c == '"' || c == '\\' || c == '`' || c == '$' || static_cast<unsigned char>(c) < 0x21) {
+      return "Not a valid web address.";
+    }
+  }
+
+  // Without following, curl reports the status and the resolved Location after the body.
+  std::string command = follow ? "curl -fsSL --proto-redir =https --connect-timeout "
+                               : "curl -sS --proto =https --max-redirs 0 --connect-timeout ";
+  command += std::to_string(Seconds(options.connect_timeout_ms));
+  if (const long long total = Seconds(options.total_timeout_ms); total > 0) {
+    command += " --max-time " + std::to_string(total);
+  }
+  command += " -A " + ShellQuote(options.user_agent);
+  for (const HttpHeader& header : options.headers) {
+    command += " -H " + ShellQuote(header.name + ": " + header.value);
+  }
+  if (!follow) {
+    command += " -w " + ShellQuote(std::string(kStatusMarker) + "%{http_code} %{redirect_url}");
+  }
+  command += " " + ShellQuote(url);
+
+  FILE* pipe = popen(command.c_str(), "r");
+  if (!pipe) {
+    return "curl is needed to download. Install it with your package manager.";
+  }
+  std::string error;
+  char buffer[1 << 16];
+  for (size_t count; (count = fread(buffer, 1, sizeof(buffer), pipe)) > 0;) {
+    if (options.max_bytes > 0 && out.size() + count > size_t(options.max_bytes) + (follow ? 0 : 4096)) {
+      error = "The server sent more data than expected.";
+      break;
+    }
+    out.append(buffer, count);
+    if (task) {
+      task->Progress(static_cast<long long>(out.size()),
+                     options.progress_total > 0 ? options.progress_total : -1);
+      if (task->cancelled()) {
+        error = "Cancelled.";
+        break;
+      }
+    }
+  }
+  const int status = pclose(pipe);
+  if (error.empty() && status != 0) {
+    error = "The download failed. Check your internet connection and try again.";
+  }
+  if (!error.empty() || follow) {
+    return error;
+  }
+  const size_t marker = out.rfind(kStatusMarker);
+  if (marker == std::string::npos) {
+    out.clear();
+    return "The download failed. Check your internet connection and try again.";
+  }
+  const std::string status_line = out.substr(marker + kStatusMarker.size());
+  out.resize(marker);
+  const size_t space = status_line.find(' ');
+  const long code = std::strtol(status_line.substr(0, space).c_str(), nullptr, 10);
+  if (IsRedirect(code)) {
+    out.clear();
+    redirect = space == std::string::npos ? std::string() : status_line.substr(space + 1);
+    return redirect.empty() ? "The server sent an invalid redirect." : "";
+  }
+  if (code != 200) {
+    out.clear();
+    return "The server answered " + std::to_string(code) + ".";
+  }
+  if (options.max_bytes > 0 && out.size() > size_t(options.max_bytes)) {
+    out.clear();
+    return "The server sent more data than expected.";
+  }
+  return "";
+}
+
+}  // namespace
+
+#endif
+
+std::string DownloadFile(Task& task, const std::string& url, const std::string& utf8_path,
+                         const HttpOptions& options) {
+  std::string data;
+  if (std::string error = HttpGet(url, data, &task, options); !error.empty()) {
+    return error;
+  }
+  const std::string part = utf8_path + ".part";
+  FILE* file = OpenFile(part, "wb");
+  if (!file) {
+    return "Cannot write " + utf8_path + ".";
+  }
+  const bool ok = std::fwrite(data.data(), 1, data.size(), file) == data.size();
+  const bool closed = std::fclose(file) == 0;
+  if (!ok || !closed || !MoveFileOver(part, utf8_path)) {
+    RemoveFile(part);
+    return "Cannot write " + utf8_path + ".";
+  }
+  return "";
+}
+
+}  // namespace trg
