+std::string Location(HINTERNET req) {
+  DWORD bytes = 0;
+  WinHttpQueryHeaders(req, WINHTTP_QUERY_LOCATION, WINHTTP_HEADER_NAME_BY_INDEX, nullptr, &bytes,
+                      WINHTTP_NO_HEADER_INDEX);
+  if (bytes == 0) {
+    return {};
+  }
+  std::wstring location(bytes / sizeof(wchar_t) + 1, L'\0');
+  if (!WinHttpQueryHeaders(req, WINHTTP_QUERY_LOCATION, WINHTTP_HEADER_NAME_BY_INDEX, location.data(), &bytes,
+                           WINHTTP_NO_HEADER_INDEX)) {
+    return {};
+  }
+  location.resize(bytes / sizeof(wchar_t));
+  return Narrow(location);
+}
