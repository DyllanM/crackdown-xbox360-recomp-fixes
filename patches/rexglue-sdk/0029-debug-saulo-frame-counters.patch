diff --git a/include/rex/debug_saulo_frame.h b/include/rex/debug_saulo_frame.h
new file mode 100644
index 0000000..eeba979
--- /dev/null
+++ b/include/rex/debug_saulo_frame.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <cstdint>
+
+// DEBUG_SAULO: frame pipeline event counters read by the title's once-per-second sampler.
+namespace rex::debug_saulo {
+
+enum class FrameEvent : uint32_t {
+  kVblank,
+  kCommandProcessorSwap,
+  kGuestOutputRefresh,
+  kGuestOutputConsumed,
+  kGuestOutputReplaced,
+  kHostPresent,
+  kCount,
+};
+
+void CountFrameEvent(FrameEvent event);
+uint64_t GetFrameEventCount(FrameEvent event);
+
+}  // namespace rex::debug_saulo
diff --git a/src/core/debug_saulo_frame.cpp b/src/core/debug_saulo_frame.cpp
new file mode 100644
index 0000000..ee52869
--- /dev/null
+++ b/src/core/debug_saulo_frame.cpp
@@ -0,0 +1,21 @@
+#include <array>
+#include <atomic>
+
+#include <rex/debug_saulo_frame.h>
+
+namespace rex::debug_saulo {
+namespace {
+
+std::array<std::atomic<uint64_t>, static_cast<size_t>(FrameEvent::kCount)> g_counts{};
+
+}  // namespace
+
+void CountFrameEvent(FrameEvent event) {
+  g_counts[static_cast<size_t>(event)].fetch_add(1, std::memory_order_relaxed);
+}
+
+uint64_t GetFrameEventCount(FrameEvent event) {
+  return g_counts[static_cast<size_t>(event)].load(std::memory_order_relaxed);
+}
+
+}  // namespace rex::debug_saulo
