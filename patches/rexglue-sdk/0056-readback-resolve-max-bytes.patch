+uint32_t CommandProcessor::GetReadbackResolveSizeLimit(ReadbackResolveMode mode) const {
+  if (mode == ReadbackResolveMode::kDisabled) {
+    return 0;
+  }
+  int32_t max_bytes = REXCVAR_GET(readback_resolve_max_bytes);
+  return max_bytes > 0 ? uint32_t(max_bytes) : UINT32_MAX;
+}
