diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index f0e7196..e8a8f61 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -10,6 +10,7 @@
  */
 
 #include <algorithm>
+#include <bit>
 #include <chrono>
 #include <cstdarg>
 #include <cstring>
@@ -59,6 +60,11 @@ REXCVAR_DEFINE_BOOL(d3d12_async_submission, true, "GPU/D3D12",
                     "command processor thread")
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
 
+REXCVAR_DEFINE_BOOL(gpu_host_threads_avoid_cpu0, true, "GPU",
+                    "Keep the GPU command processor and D3D12 submission threads off logical CPUs "
+                    "0 and 1, where Windows handles most interrupts and DPCs")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
 REXCVAR_DEFINE_UINT32(d3d12_async_submission_draws, 2000, "GPU/D3D12",
                       "With d3d12_async_submission, also end the submission every this many draws "
                       "outside occlusion queries, so less of the frame is left for the swap "
@@ -147,6 +153,21 @@ void DebugSauloReportD3D12() {
 // What is left of this frame's wait for pipelines created in the background (async_shader_wait_ms).
 int64_t pipeline_wait_budget_us = 0;
 
+// The process's logical CPUs except 0 and 1, or 0 to leave the threads alone: with fewer than 8, or
+// when the process spans several processor groups (no single-group mask then).
+uint64_t GetHostThreadAffinityMask() {
+  if (!REXCVAR_GET(gpu_host_threads_avoid_cpu0)) {
+    return 0;
+  }
+  DWORD_PTR process_mask = 0;
+  DWORD_PTR system_mask = 0;
+  if (!GetProcessAffinityMask(GetCurrentProcess(), &process_mask, &system_mask) ||
+      std::popcount(uint64_t(process_mask)) < 8) {
+    return 0;
+  }
+  return uint64_t(process_mask) & ~uint64_t(0b11);
+}
+
 }  // namespace
 
 // Generated with `xb buildshaders`.
@@ -1727,6 +1748,19 @@ bool D3D12CommandProcessor::SetupContext() {
     StartAsyncSubmission();
   }
 
+  // Best effort: the threads keep their affinity if this fails.
+  uint64_t host_thread_affinity_mask = GetHostThreadAffinityMask();
+  if (host_thread_affinity_mask) {
+    if (rex::thread::Thread* command_processor_thread = rex::thread::Thread::GetCurrentThread()) {
+      command_processor_thread->set_affinity_mask(host_thread_affinity_mask);
+    }
+    if (async_submission_thread_) {
+      async_submission_thread_->set_affinity_mask(host_thread_affinity_mask);
+    }
+  }
+  REXGPU_INFO("[DEBUG_SAULO][GpuHostThreads] affinity_mask={:#x} async_submission={}",
+              host_thread_affinity_mask, async_submission_enabled_);
+
   return true;
 }
 
