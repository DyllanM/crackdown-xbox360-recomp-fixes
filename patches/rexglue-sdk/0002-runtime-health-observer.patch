 #include <algorithm>
+#include <atomic>
+#include <rex/system/thread_state.h>
 #include <cctype>
 #include <charconv>
 #include <filesystem>
@@ -57,6 +59,25 @@
     .lifecycle(rex::cvar::Lifecycle::kInitOnly);
 
 namespace rex {
+
+namespace { std::atomic<RuntimeObserver> runtime_observer{nullptr}; }
+
+void SetRuntimeObserver(RuntimeObserver observer) {
+  runtime_observer.store(observer, std::memory_order_release);
+}
+
+bool RuntimeObserverActive() { return runtime_observer.load(std::memory_order_acquire) != nullptr; }
+
+void ObserveRuntime(const char* category, const char* event, uint64_t object,
+                    uint64_t a, uint64_t b, uint64_t c, uint64_t d, const char* detail) {
+  auto observer = runtime_observer.load(std::memory_order_acquire);
+  if (!observer) return;
+  auto* thread = runtime::ThreadState::Get();
+  const uint32_t caller = thread && thread->context() ? uint32_t(thread->context()->lr) : 0;
+  observer(category, event, object, a, b, c, d, detail, caller,
+           thread ? thread->thread_id() : 0);
+}
+
 
