+namespace {
+
+GuestPageRecovery g_guest_page_recovery;
+
+bool TryRecoverGuestReadPage(BaseHeap* heap, uint32_t guest_address, bool is_write) {
+  if (is_write || guest_address < GuestPageRecovery::kRangeBegin ||
+      guest_address > GuestPageRecovery::kRangeEnd ||
+      heap->heap_type() != memory::HeapType::kGuestVirtual) {
+    return false;
+  }
+  const auto* thread_state = runtime::ThreadState::Get();
+  if (!thread_state) {
+    return false;
+  }
+  const uint32_t page_size = heap->page_size();
+  const uint32_t page = guest_address & ~(page_size - 1);
+  HeapAllocationInfo info{};
+  const bool committed = !heap->QueryRegionInfo(page, &info) ||
+                         (info.state & memory::kMemoryAllocationCommit) != 0;
+  const auto verdict = g_guest_page_recovery.Evaluate(
+      is_write ? GuestAccessKind::kWrite : GuestAccessKind::kRead, guest_address, page, committed);
+  if (verdict == GuestPageRecoveryVerdict::kNotEligible) {
+    return false;
+  }
+
+  const uint32_t recovered = g_guest_page_recovery.count();
+  const ::PPCContext& ctx = *thread_state->context();
+  REXSYS_WARN(
+      "[SAVE_RECOVERY] Guest read fault: addr=0x{:08X} page=0x{:08X} PC=unavailable "
+      "LR=0x{:08X} r3=0x{:08X} r4=0x{:08X} r5=0x{:08X} r6=0x{:08X} r7=0x{:08X} r8=0x{:08X} "
+      "r9=0x{:08X} r10=0x{:08X} r11=0x{:08X} r12=0x{:08X} thread=0x{:X} recovery={}/{}",
+      guest_address, page, uint32_t(ctx.lr), ctx.r3.u32, ctx.r4.u32, ctx.r5.u32, ctx.r6.u32,
+      ctx.r7.u32, ctx.r8.u32, ctx.r9.u32, ctx.r10.u32, ctx.r11.u32, ctx.r12.u32,
+      thread_state->thread_id(), recovered, GuestPageRecovery::kMaxPages);
+
+  if (verdict != GuestPageRecoveryVerdict::kRecover) {
+    if (verdict == GuestPageRecoveryVerdict::kAlreadyRecovered) {
+      REXSYS_ERROR(
+          "[SAVE_RECOVERY] Recovery refused: page=0x{:08X} reason=already_recovered_but_faulted",
+          page);
+    } else {
+      REXSYS_ERROR("[SAVE_RECOVERY] Recovery refused: page=0x{:08X} reason=limit count={}/{}", page,
+                   recovered, GuestPageRecovery::kMaxPages);
+    }
+    return false;
+  }
+
+  const bool reserved = (info.state & memory::kMemoryAllocationReserve) != 0;
+  const uint32_t allocation_type =
+      reserved ? memory::kMemoryAllocationCommit
+               : (memory::kMemoryAllocationReserve | memory::kMemoryAllocationCommit);
+  if (!heap->AllocFixed(page, page_size, page_size, allocation_type,
+                        memory::kMemoryProtectRead | memory::kMemoryProtectWrite)) {
+    REXSYS_ERROR("[SAVE_RECOVERY] Recovery failed: page=0x{:08X} reason=map_failed", page);
+    return false;
+  }
+  std::memset(heap->TranslateRelative(page - heap->heap_base()), 0, page_size);
+  g_guest_page_recovery.Record(page);
+  REXSYS_WARN("[SAVE_RECOVERY] Mapped zero page 0x{:08X} recovery={}/{}", page,
+              g_guest_page_recovery.count(), GuestPageRecovery::kMaxPages);
+  return true;
+}
