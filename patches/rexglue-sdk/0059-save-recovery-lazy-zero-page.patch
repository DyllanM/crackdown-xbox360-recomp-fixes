diff --git a/include/rex/system/guest_page_recovery.h b/include/rex/system/guest_page_recovery.h
new file mode 100644
index 0000000..ffd3f8e
--- /dev/null
+++ b/include/rex/system/guest_page_recovery.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace rex::memory {
+
+enum class GuestAccessKind { kRead, kWrite, kExecute };
+
+enum class GuestPageRecoveryVerdict {
+  kRecover,
+  kNotEligible,
+  kAlreadyRecovered,
+  kLimitReached,
+};
+
+class GuestPageRecovery {
+ public:
+  static constexpr uint32_t kRangeBegin = 0x70000000;
+  static constexpr uint32_t kRangeEnd = 0x70FFFFFF;
+  static constexpr uint32_t kMaxPages = 8;
+
+  GuestPageRecoveryVerdict Evaluate(GuestAccessKind access, uint32_t guest_address,
+                                    uint32_t page_address, bool page_committed) const {
+    if (access != GuestAccessKind::kRead || guest_address < kRangeBegin ||
+        guest_address > kRangeEnd || page_committed) {
+      return GuestPageRecoveryVerdict::kNotEligible;
+    }
+    for (uint32_t i = 0; i < count_; ++i) {
+      if (pages_[i] == page_address) {
+        return GuestPageRecoveryVerdict::kAlreadyRecovered;
+      }
+    }
+    return count_ >= kMaxPages ? GuestPageRecoveryVerdict::kLimitReached
+                               : GuestPageRecoveryVerdict::kRecover;
+  }
+
+  void Record(uint32_t page_address) {
+    if (count_ < kMaxPages) {
+      pages_[count_++] = page_address;
+    }
+  }
+
+  uint32_t count() const { return count_; }
+
+ private:
+  std::array<uint32_t, kMaxPages> pages_{};
+  uint32_t count_ = 0;
+};
+
+}  // namespace rex::memory
