+namespace {
+
+// DEBUG_SAULO: counts lookups and identical misses, and logs them every few seconds while the guest looks up paths.
+// Called with the global lock held.
+void DebugSauloCountLookup(const std::string& normalized_path, bool found, bool device_found) {
+  auto& stats = debug_saulo::vfs_stats;
+  stats.lookups.fetch_add(1, std::memory_order_relaxed);
+  if (!found) {
+    stats.misses.fetch_add(1, std::memory_order_relaxed);
+    if (!device_found) {
+      stats.device_misses.fetch_add(1, std::memory_order_relaxed);
+    }
+    static uint64_t recent_misses[1024] = {};
+    const uint64_t hash = std::hash<std::string>{}(normalized_path) | 1;
+    uint64_t& slot = recent_misses[hash % std::size(recent_misses)];
+    if (slot == hash) {
+      stats.repeated_misses.fetch_add(1, std::memory_order_relaxed);
+    }
+    slot = hash;
+  }
+  static int64_t last_report_ns = debug_saulo::NowNs();
+  const int64_t now = debug_saulo::NowNs();
+  if (now - last_report_ns < 5'000'000'000) {
+    return;
+  }
+  const double seconds = double(now - last_report_ns) * 1e-9;
+  last_report_ns = now;
+  auto take = [](std::atomic<uint64_t>& counter) { return counter.exchange(0, std::memory_order_relaxed); };
+  REXFS_INFO(
+      "[DEBUG_SAULO][PerfVfs] window_s={:.1f} lookups={} misses={} no_device={} repeated_misses={} host_fallbacks={} "
+      "host_stats={} host_listings={} host_fallback_ms={:.2f}",
+      seconds, take(stats.lookups), take(stats.misses), take(stats.device_misses), take(stats.repeated_misses),
+      take(stats.host_fallbacks), take(stats.host_stats), take(stats.host_listings),
+      double(take(stats.host_fallback_ns)) * 1e-6);
+}
