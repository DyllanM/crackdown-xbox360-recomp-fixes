@@ -0,0 +1,29 @@
+#pragma once
+
+// DEBUG_SAULO: VFS lookup counters for the temporary performance report. Remove before release.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace rex::filesystem::debug_saulo {
+
+struct VfsStats {
+  std::atomic<uint64_t> lookups{0};
+  std::atomic<uint64_t> misses{0};
+  std::atomic<uint64_t> device_misses{0};
+  std::atomic<uint64_t> repeated_misses{0};
+  std::atomic<uint64_t> host_fallbacks{0};
+  std::atomic<uint64_t> host_stats{0};
+  std::atomic<uint64_t> host_listings{0};
+  std::atomic<uint64_t> host_fallback_ns{0};
+};
+
+inline VfsStats vfs_stats;
+
+inline int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+}  // namespace rex::filesystem::debug_saulo
