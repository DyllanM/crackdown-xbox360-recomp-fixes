+// DEBUG_SAULO: command processor counters for the performance report, logged at a swap every few seconds.
+struct DebugSauloCommandProcessorStats {
+  std::atomic<uint64_t> swaps{0};
+  std::atomic<uint64_t> idle_waits{0};
+  std::atomic<uint64_t> idle_polls{0};
+  std::atomic<uint64_t> idle_background_polls{0};
+  std::atomic<uint64_t> idle_ns{0};
+  std::atomic<uint64_t> wait_reg_mem{0};
+  std::atomic<uint64_t> wait_reg_mem_waits{0};
+  std::atomic<uint64_t> wait_reg_mem_ns{0};
+  std::atomic<uint64_t> read_pointer_writebacks{0};
+  std::atomic<uint64_t> scratch_writebacks{0};
+  int64_t last_report_ns = 0;
+};
+DebugSauloCommandProcessorStats debug_saulo_cp_stats;
+
+int64_t DebugSauloNowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+uint64_t DebugSauloTake(std::atomic<uint64_t>& counter) {
+  return counter.exchange(0, std::memory_order_relaxed);
+}
+
+void DebugSauloReportCommandProcessor() {
+  DebugSauloCommandProcessorStats& stats = debug_saulo_cp_stats;
+  stats.swaps.fetch_add(1, std::memory_order_relaxed);
+  const int64_t now = DebugSauloNowNs();
+  if (!stats.last_report_ns) {
+    stats.last_report_ns = now;
+  }
+  if (now - stats.last_report_ns < 5'000'000'000) {
+    return;
+  }
+  stats.last_report_ns = now;
+  REXGPU_INFO(
+      "[DEBUG_SAULO][PerfCommandProcessor] swaps={} idle_waits={} idle_polls={} idle_background_polls={} "
+      "idle_ms={:.1f} wait_reg_mem={} wait_reg_mem_waits={} wait_reg_mem_ms={:.1f} read_pointer_writebacks={} "
+      "scratch_writebacks={}",
+      DebugSauloTake(stats.swaps), DebugSauloTake(stats.idle_waits), DebugSauloTake(stats.idle_polls),
+      DebugSauloTake(stats.idle_background_polls), double(DebugSauloTake(stats.idle_ns)) * 1e-6,
+      DebugSauloTake(stats.wait_reg_mem), DebugSauloTake(stats.wait_reg_mem_waits),
+      double(DebugSauloTake(stats.wait_reg_mem_ns)) * 1e-6, DebugSauloTake(stats.read_pointer_writebacks),
+      DebugSauloTake(stats.scratch_writebacks));
+}
+
+}  // namespace
