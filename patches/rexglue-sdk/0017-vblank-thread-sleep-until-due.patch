diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index 8f2fcb0..ecd082b 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -166,7 +166,17 @@ X_STATUS GraphicsSystem::SetupGuestGpu(runtime::FunctionDispatcher* function_dis
             MarkVblank();
             last_frame_time += interval_ticks;
           }
-          rex::thread::Sleep(std::chrono::milliseconds(1));
+          // Wait for the next vblank instead of polling for it.
+          current_time = chrono::Clock::QueryGuestTickCount();
+          uint64_t elapsed_ticks = current_time - last_frame_time;
+          if (elapsed_ticks >= interval_ticks) {
