diff --git a/include/rex/filesystem/expected_miss.h b/include/rex/filesystem/expected_miss.h
new file mode 100644
index 0000000..9e4640c
--- /dev/null
+++ b/include/rex/filesystem/expected_miss.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <cstdint>
+#include <string_view>
+
+#include <rex/filesystem.h>
+#include <rex/system/xtypes.h>
+
+namespace rex::filesystem {
+
+// The kernel has no current directory, so a path without a device can never resolve.
+constexpr bool IsDeviceRelativeGuestPath(std::string_view path) {
+  if (!path.empty() && path.front() == '\\') {
+    return false;
+  }
+  return path.substr(0, path.find('\\')).find(':') == std::string_view::npos;
+}
+
+// A read-only open of an existing file that finds nothing is how titles probe for optional files.
+constexpr bool IsExpectedOpenMiss(bool opens_existing_only, uint32_t desired_access,
+                                  X_STATUS status) {
+  constexpr uint32_t kWriteAccess = FileAccess::kGenericWrite | FileAccess::kGenericAll |
+                                    FileAccess::kFileWriteData | FileAccess::kFileAppendData;
+  return opens_existing_only && !(desired_access & kWriteAccess) &&
+         (status == X_STATUS_NO_SUCH_FILE || status == X_STATUS_OBJECT_NAME_NOT_FOUND);
+}
+
+}  // namespace rex::filesystem
