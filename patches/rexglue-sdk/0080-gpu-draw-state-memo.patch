+void DebugSauloReportDrawStateMemo(uint64_t frames) {
+  DebugSauloDrawStateMemoStats& stats = DebugSauloDrawStateMemo();
+  const double frame_count = double(std::max<uint64_t>(frames, 1));
+  REXGPU_INFO(
+      "[DEBUG_SAULO][PerfDrawMemo] ownership_hits_per_frame={:.0f} ownership_misses_per_frame={:.0f} "
+      "transfer_skips_per_frame={:.0f} sampler_hits_per_frame={:.0f} sampler_misses_per_frame={:.0f}",
+      double(stats.ownership_hits) / frame_count, double(stats.ownership_misses) / frame_count,
+      double(stats.transfer_skips) / frame_count, double(stats.sampler_hits) / frame_count,
+      double(stats.sampler_misses) / frame_count);
+  stats = {};
+}
