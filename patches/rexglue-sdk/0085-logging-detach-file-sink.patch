+void DetachFileSink() {
+  std::lock_guard lock(g_mutex);
+  if (!g_file_sink)
+    return;
+  std::erase(g_extra_sinks, g_file_sink);
+  for (auto& entry : g_registry) {
+    if (entry.logger)
+      std::erase(entry.logger->sinks(), g_file_sink);
+  }
+  g_file_sink->flush();
+  g_file_sink.reset();
+}
