+// Writes the title's XDBF icon into a linear k_8_8_8_8 surface with the given row pitch: one big-endian dword per
+// texel, red in the low byte. Texels outside the decoded image keep the fill.
+void WriteTileImage(void* buffer, u32 stride, u32 height, u64 image_id) {
+  const util::XdbfGameData db = REX_KERNEL_STATE()->title_xdbf();
+  if (!db.is_valid()) {
+    return;
+  }
+  const util::XdbfBlock block = db.GetEntry(util::XdbfSection::kImage, image_id);
+  if (!block) {
+    return;
+  }
+  int image_width = 0;
+  int image_height = 0;
+  const std::vector<uint8_t> rgba =
+      rex::ui::DecodeImageRGBA(block.buffer, block.size, image_width, image_height);
+  if (rgba.empty()) {
+    return;
+  }
+  auto* bytes = static_cast<uint8_t*>(buffer);
+  const u32 columns = (std::min)(u32(image_width), stride / 4);
+  const u32 rows = (std::min)(u32(image_height), height);
+  for (u32 y = 0; y < rows; ++y) {
+    for (u32 x = 0; x < columns; ++x) {
+      const uint8_t* texel = rgba.data() + (size_t(y) * size_t(image_width) + x) * 4;
+      const u32 packed = (u32(texel[3]) << 24) | (u32(texel[2]) << 16) | (u32(texel[1]) << 8) | u32(texel[0]);
+      rex::memory::store_and_swap<u32>(bytes + size_t(y) * stride + size_t(x) * 4, packed);
+    }
+  }
+}
