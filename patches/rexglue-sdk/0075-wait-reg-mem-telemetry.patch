+void DebugSauloRecordWaitRegMemTarget(bool is_memory, uint32_t poll_reg_addr) {
+  if (!is_memory) {
+    return;
+  }
+  DebugSauloCommandProcessorStats& stats = debug_saulo_cp_stats;
+  const size_t slot = (poll_reg_addr >> 2) % std::size(stats.wait_reg_mem_hot_addr);
+  if (stats.wait_reg_mem_hot_addr[slot].exchange(poll_reg_addr, std::memory_order_relaxed) == poll_reg_addr) {
+    stats.wait_reg_mem_hot_count[slot].fetch_add(1, std::memory_order_relaxed);
+  } else {
+    stats.wait_reg_mem_hot_count[slot].store(1, std::memory_order_relaxed);
+  }
+}
+
+void DebugSauloReportWaitRegMem() {
+  DebugSauloCommandProcessorStats& stats = debug_saulo_cp_stats;
+  static constexpr const char* kConditionNames[8] = {"never", "lt", "le", "eq", "ne", "ge", "gt", "always"};
+  std::string conditions;
+  for (size_t i = 0; i < std::size(stats.wait_reg_mem_conditions); ++i) {
+    conditions += fmt::format(" {}={}", kConditionNames[i], DebugSauloTake(stats.wait_reg_mem_conditions[i]));
+  }
+  std::string hot;
+  for (size_t i = 0; i < std::size(stats.wait_reg_mem_hot_addr); ++i) {
+    const uint64_t count = DebugSauloTake(stats.wait_reg_mem_hot_count[i]);
+    if (count) {
+      hot += fmt::format(" {:08X}={}", stats.wait_reg_mem_hot_addr[i].load(std::memory_order_relaxed), count);
+    }
+  }
+  const uint64_t calls = DebugSauloTake(stats.wait_reg_mem);
+  const uint64_t iterations = DebugSauloTake(stats.wait_reg_mem_iterations);
+  REXGPU_INFO(
+      "[DEBUG_SAULO][PerfWaitRegMem] calls={} repolls={} memory={} register={} fast_branch={} escalated_branch={} "
+      "background_work_calls={} event_waits={} event_wakeups={} event_timeouts={} timeout_completed={} "
+      "timeout_incomplete={}{} hot={}",
+      calls, iterations - std::min(calls, iterations), DebugSauloTake(stats.wait_reg_mem_memory),
+      DebugSauloTake(stats.wait_reg_mem_register), DebugSauloTake(stats.wait_reg_mem_fast_branch),
+      DebugSauloTake(stats.wait_reg_mem_escalated_branch),
+      DebugSauloTake(stats.wait_reg_mem_background_work_calls), DebugSauloTake(stats.wait_reg_mem_event_waits),
+      DebugSauloTake(stats.wait_reg_mem_event_wakeups), DebugSauloTake(stats.wait_reg_mem_event_timeouts),
+      DebugSauloTake(stats.wait_reg_mem_timeout_completed), DebugSauloTake(stats.wait_reg_mem_timeout_incomplete),
+      conditions, hot.empty() ? " none" : hot);
+}
