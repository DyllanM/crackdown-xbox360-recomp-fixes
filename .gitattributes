# rexglue codegen rewrites the manifest with LF endings on every run.
crackdown_manifest.toml text eol=lf

# The runtime patches and baseline are hashed; their bytes must be the same on every checkout.
patches/rexglue-sdk/* text eol=lf

# Linux scripts and files run on Linux whatever the checkout's line endings.
*.sh text eol=lf
packaging/linux/* text eol=lf

# The AppImage runtime patch and pins are applied and hashed on Linux.
patches/appimage-runtime/* text eol=lf

# The TRG Launcher patches are applied to a build-tree copy; keep them byte-stable across checkouts.
patches/trg-launcher/* text eol=lf
